{
  "info": {
    "name": "Tasks REST API",
    "description": "Postman collection for the Tasks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tasks — CRUD",
      "item": [
        {
          "name": "Create task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (res.getStatus() === 201) {",
                  "  const json = res.getBody();",
                  "  bru.setCollectionVar('taskId', json.data.id);",
                  "  test('Task id saved to collection variable', () => {",
                  "    expect(json.data.id).to.be.a('string');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My first task\",\n  \"description\": \"Created from Postman\",\n  \"status\": \"todo\",\n  \"dueDate\": \"2026-08-15T00:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          },
          "response": []
        },
        {
          "name": "Create task (minimal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Minimal task\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          },
          "response": []
        },
        {
          "name": "Get task by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "response": []
        },
        {
          "name": "Update task (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"description\": \"Updated via PUT\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "response": []
        },
        {
          "name": "Partial update (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Patched title only\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "response": []
        },
        {
          "name": "Mark task done (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "response": []
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tasks — List & filters",
      "item": [
        {
          "name": "List all tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks"
          },
          "response": []
        },
        {
          "name": "List with pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Filter by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=done",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "done",
                  "description": "todo | in_progress | done"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search by query (q)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?q=report",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "report",
                  "description": "Search title and description"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Combined filter + search + pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=todo&q=task&page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "todo"
                },
                {
                  "key": "q",
                  "value": "task"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "404 — Unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/does-not-exist"
          },
          "response": []
        },
        {
          "name": "404 — Task not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/00000000-0000-0000-0000-000000000000"
          },
          "response": []
        },
        {
          "name": "400 — Create with empty title",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          },
          "response": []
        },
        {
          "name": "400 — Update with empty body",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "response": []
        },
        {
          "name": "400 — Invalid list status param",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=invalid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "invalid"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "400 — Invalid status transition (done → todo)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"todo\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "description": "Run after \"Mark task done (PATCH)\" — expects 400."
          },
          "response": []
        }
      ]
    }
  ]
}